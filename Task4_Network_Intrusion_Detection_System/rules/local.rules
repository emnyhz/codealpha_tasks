alert icmp $HOME_NET any -> any any (msg:"CODEALPHA ICMP Echo Request Detected"; itype:8; sid:1000001; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"CODEALPHA Repeated SSH Connection Attempts"; flags:S; flow:stateless; detection_filter:track by_src,count 5,seconds 60; priority:1; sid:1000002; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"CODEALPHA Possible TCP SYN Port Scan"; flags:S; flow:stateless; detection_filter:track by_src,count 20,seconds 10; priority:2; sid:1000003; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CODEALPHA Suspicious .env File Access Attempt"; flow:to_server,established; http.uri; content:".env"; nocase; priority:1; sid:1000004; rev:1;)

